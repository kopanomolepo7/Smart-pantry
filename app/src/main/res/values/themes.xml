<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SmartPantryManager" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pantry_ochre</item>
        <item name="colorPrimaryDark">@color/pantry_bar</item>
        <item name="colorAccent">@color/pantry_ochre</item>
        <item name="android:windowBackground">@color/pantry_parchment</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pantry_bar</item>
    </style>

    <!-- Serif toolbar titles give screens a printed-recipe-card feel
         instead of the default sans-serif app-bar look. -->
    <style name="ToolbarTitleStyle" parent="TextAppearance.Widget.AppCompat.Toolbar.Title">
        <item name="android:fontFamily">serif</item>
    </style>
</resources>
